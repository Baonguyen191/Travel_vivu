DATABASE_URL=postgresql://travel:travel@localhost:5433/travel
# Database riêng cho test, để `pytest` không bao giờ TRUNCATE dữ liệu dev/thật.
# Mặc định (nếu bỏ trống) dùng lại toàn bộ DATABASE_URL (kể cả thông tin
# đăng nhập), chỉ đổi tên database thành "travel_test"; database này được
# tự tạo khi chạy test.
TEST_DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_test
CONTACT_EMAIL=you@example.com
# Key OpenAI cho agent LLM và nhận diện ảnh (demo). Không có thì demo chạy chế độ luật.
# Riêng demo và agent đọc được key từ file .env này; pipeline dữ liệu thì không.
OPENAI_API_KEY=
# Tuỳ chọn, mặc định gpt-5.4-mini.
# OPENAI_MODEL=gpt-5.4-mini
# Server OSRM (định tuyến miễn phí). Mặc định http://localhost:5100.
# Dựng: python scripts/setup_osrm.py && docker compose --profile routing up -d osrm
# OSRM_URL=http://localhost:5100
# Key Google Maps Platform đã bật Routes API VÀ bật billing cho project (bắt buộc,
# kể cả khi dùng trong hạn mức miễn phí). Để trống thì thời gian đi là ước lượng.
# Dự án không tự nạp .env: đặt biến này trong shell trước khi chạy.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
