DATABASE_URL=postgresql://travel:travel@localhost:5433/travel
# Database riêng cho test, để `pytest` không bao giờ TRUNCATE dữ liệu dev/thật.
# Mặc định (nếu bỏ trống) dùng lại toàn bộ DATABASE_URL (kể cả thông tin
# đăng nhập), chỉ đổi tên database thành "travel_test"; database này được
# tự tạo khi chạy test.
TEST_DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_test
CONTACT_EMAIL=you@example.com
# LLM cho agent, nhận diện ảnh và baseline lập lịch, qua API tương thích OpenAI.
# Riêng demo, agent và planner.experiment đọc được các biến này từ file .env; pipeline dữ liệu thì không.
# Không cấu hình gì thì demo chạy chế độ luật.
#
# Mặc định: Ollama local, miễn phí, không cần key.
#   winget install Ollama.Ollama
#   setx OLLAMA_CONTEXT_LENGTH 8192   (rồi khởi động lại Ollama; context mặc định nhỏ làm cắt prompt âm thầm)
#   ollama pull qwen3.5:9b            (dự phòng khi thiếu VRAM: qwen3.5:4b)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.5:9b
# OpenAI: bỏ OPENAI_BASE_URL, đặt key và OPENAI_MODEL=gpt-5.4-mini.
OPENAI_API_KEY=
# Gemini (free tier, key từ Google AI Studio): dùng cho baseline, truyền qua tham số dòng lệnh
#   --base-url https://generativelanguage.googleapis.com/v1beta/openai/ --api-key-env GEMINI_API_KEY
# GEMINI_API_KEY=
# Server OSRM (định tuyến miễn phí). Mặc định http://localhost:5100.
# Dựng: python scripts/setup_osrm.py && docker compose --profile routing up -d osrm
# OSRM_URL=http://localhost:5100
# Key Google Maps Platform đã bật Routes API VÀ bật billing cho project (bắt buộc,
# kể cả khi dùng trong hạn mức miễn phí). Để trống thì thời gian đi là ước lượng.
# Dự án không tự nạp .env: đặt biến này trong shell trước khi chạy.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
